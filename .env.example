# OMEGA AI Factory — 환경변수 템플릿
# 이 파일을 복사해 `.env` 로 만들고 실제 값을 채우세요.
# `.env` 는 .gitignore 로 커밋되지 않으며, 이 .example 만 버전관리됩니다.

# ── LLM API 키 ─────────────────────────────────
GOOGLE_API_KEY=your-google-ai-studio-key
XAI_API_KEY=your-xai-api-key
groq_api_key=your-groq-api-key
# Cerebras 무료 티어(일 100만 토큰, 카드 불필요) — 3차 폴백. 미설정 시 게이트웨이가 자동 비활성.
# 키 발급: https://cloud.cerebras.ai
CEREBRAS_API_KEY=your-cerebras-api-key

# OpenRouter 무료 티어/다중 모델 연동 — 4차 폴백. 미설정 시 게이트웨이가 자동 비활성.
# 키 발급: https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key

# ── LangSmith / LangChain 추적 (선택) ──────────
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=omega-ai-factory

# ── 모델 설정 ──────────────────────────────────
GEMINI_MODEL_NAME=gemini-2.5-flash-lite

# ===== 외부 데이터 수집 Provider 자격증명 =====
# ⚠️ 값을 코드·설정파일·커밋에 적지 않는다. 이 파일은 **이름만** 알려 주는 견본이다.
#    수집기는 이 이름으로 환경에서만 읽고(`Provider.credential()`), 요청 URL 에서 값을
#    지운 뒤에야 원문을 보관한다(`raw_store.assert_no_secret` 이 확인한다).
# 금융감독원 전자공시 OpenDART — https://opendart.fss.or.kr 에서 발급(무료·일 한도 있음)
AFS_OPENDART_API_KEY=your-opendart-api-key
