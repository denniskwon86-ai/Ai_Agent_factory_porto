# ===== Secrets =====
.env
.env.*
!.env.example
# 점 없는 변형(env, env.example 등)도 실키가 담길 수 있으므로 전부 제외.
# 버전관리되는 정본 템플릿은 오직 .env.example(점 있음) 하나뿐이다.
/env
/env.*

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/

# ===== Node / Frontend =====
node_modules/
.vite/
dist/

# ===== LangGraph runtime (generated checkpoints / store / vectors) =====
.langgraph/
.langgraph_api/

# ===== Runtime data (generated per run) =====
outputs/
projects/
workspace/
library/
# 실패 번들(진단 자료). 워크스페이스 롤백(git clean -fd)에 지워지지 않도록 여기에 쓰지만,
# 저장소에 커밋할 성격은 아니다(pytest 도 tmp 워크스페이스 이름으로 하위 폴더를 만든다).
data/failures/

